# Neon / PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# Public app URL used by links and GitHub Actions examples.
# Local development:
APP_URL="http://localhost:3000"
# Production example:
# APP_URL="https://your-vercel-domain.vercel.app"

# Access protection
# Generate APP_ACCESS_SECRET with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ACCESS_SECRET="replace-with-random-cookie-signing-secret"
DEMO_ACCESS_CODE="replace-with-shared-demo-code"
ADMIN_ACCESS_PASSWORD="replace-with-private-admin-password"

# Source connectors
# GitHub works without a token, but a token improves rate-limit reliability.
GITHUB_TOKEN=""

# YouTube is implemented but disabled by default to protect quota.
# Enable only after adding a valid YouTube Data API key.
ENABLE_YOUTUBE_CONNECTOR=false
YOUTUBE_API_KEY=""

# arXiv requires no API key. Enabled by default because it uses one lightweight
# public Atom API request per scan. Set false if you want only product/community sources.
ENABLE_ARXIV_CONNECTOR=true

# Protected scheduled scan / cleanup
# Generate CRON_SECRET with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="replace-with-random-cron-secret"
CRON_SCAN_MODE="balanced"
CRON_SCAN_WINDOW_DAYS=30
CRON_RETENTION_DAYS=30
